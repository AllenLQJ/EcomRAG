# 这些变量会公开给浏览器；不要在此放凭据。
VITE_API_BASE=
# 仅供开发服务器代理 /api，生产构建不提供代理。
VITE_PROXY_TARGET=http://127.0.0.1:8010
# 留空时隐藏所有人工客服链接，配置完整 http(s) 地址。
VITE_HUMAN_SUPPORT_URL=
VITE_SHOW_SAMPLE_BADGE=true
VITE_STORE_NAME=灵码
# 顶栏标志变体：b-seal（默认，墨印）、a-spark（灵光一点）、c-dialog（对话灵光）；聊天里的机器人头像固定用 c-dialog；预览见 /brand/index.html
VITE_LOGO=b-seal
# 1 = 离线 Mock；其他值使用真实接口。
VITE_MOCK=0
# 仅演示部署设为 1，公开显示“查看链路”开关；默认隐藏。
# 前端隐藏不是安全边界；后端 ALLOW_TRACE 默认 false，演示才开启，公网长期部署应改回 false。
VITE_SHOW_TRACE_TOGGLE=0

# 默认使用 POST SSE；0 = 仅使用非流式接口。
VITE_STREAM=1
